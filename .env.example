# --- Backend (NestJS) ---
# Nunca exponer estos valores al frontend
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
NODE_ENV=development
PORT=3000
# Origen exacto del frontend permitido por CORS (nunca "*")
FRONTEND_URL=http://localhost:5173

# --- Frontend (Vite) ---
# Prefijo VITE_ obligatorio para que Vite las incluya en el bundle.
# Solo van aqui claves publicas por diseno (anon key), nunca secretos.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
